generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model ActiveSubstance {
  id                   Int                    @id @default(autoincrement())
  name                 String                 @unique(map: "active_substance_name_unique")
  type                 SubstanceType
  genericId            Int
  GenericName          GenericName            @relation(fields: [genericId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  MedicationIngredient MedicationIngredient[]

  @@index([genericId])
  @@index([name])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "idx_activesubstance_name_trgm", type: Gin)
}

model AdminUser {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  name      String
  role      AdminRole @default(ADMIN)
  createdAt DateTime  @default(now())

  @@index([email])
}

model AnatomicalClass {
  id               Int                @id @default(autoincrement())
  atcCode          String             @unique @db.VarChar(1)
  name             String
  TherapeuticClass TherapeuticClass[]
}

model ChemicalClass {
  id                   Int                  @id @default(autoincrement())
  atcCode              String               @unique @db.VarChar(5)
  name                 String
  parentId             Int
  PharmacologicalClass PharmacologicalClass @relation(fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ChemicalSubstance    ChemicalSubstance[]

  @@index([name])
  @@index([parentId])
}

model ChemicalSubstance {
  id                           Int                            @id @default(autoincrement())
  name                         String                         @db.VarChar
  atcCode                      String                         @unique @db.VarChar(7)
  parentId                     Int
  ChemicalClass                ChemicalClass                  @relation(fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  GenericNameChemicalSubstance GenericNameChemicalSubstance[]

  @@index([atcCode])
  @@index([name])
  @@index([parentId])
}

model Contraindication {
  id          Int         @id @default(autoincrement())
  description String
  genericId   Int
  GenericName GenericName @relation(fields: [genericId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([genericId])
}

model GenericName {
  id                           Int                            @id @default(autoincrement())
  name                         String                         @unique(map: "generic_name_unique")
  description                  String?
  ActiveSubstance              ActiveSubstance[]
  Contraindication             Contraindication[]
  GenericNameChemicalSubstance GenericNameChemicalSubstance[]
  Indication                   Indication[]

  @@index([name])
}

model GenericNameChemicalSubstance {
  id                  Int               @id @default(autoincrement())
  genericNameId       Int
  chemicalSubstanceId Int
  ChemicalSubstance   ChemicalSubstance @relation(fields: [chemicalSubstanceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  GenericName         GenericName       @relation(fields: [genericNameId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([genericNameId, chemicalSubstanceId])
  @@index([chemicalSubstanceId])
  @@index([genericNameId])
}

model Indication {
  id          Int         @id @default(autoincrement())
  description String
  genericId   Int
  GenericName GenericName @relation(fields: [genericId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([genericId])
}

model Manufacturer {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  country     String?
  contactInfo String?
  Medication  Medication[]

  @@index([name])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Medication {
  id                              Int                               @id @default(autoincrement())
  brandName                       String
  brandDescription                String?
  localNames                      String[]                          @default([])
  manufacturerId                  Int?
  form                            DosageForm?
  route                           Route?
  packSizeQuantity                Int?
  packSizeUnit                    PackSizeUnit?
  nafdacCode                      String                            @unique
  nafdacStatus                    NafdacStatus?                     @default(PENDING)
  prescriptionRequired            Boolean
  regulatoryClass                 RegulatoryClass?
  restrictedTo                    RestrictedTo?
  insuranceCoverage               Boolean?                          @default(false)
  createdAt                       DateTime                          @default(now())
  approvalDate                    DateTime?
  expiryDate                      DateTime?
  storageConditions               String?
  imageUrl                        String?
  fullName                        String?
  packSizeExpression              String?                           @db.VarChar(50)
  pharmacopeia                    Pharmacopeia?
  Manufacturer                    Manufacturer?                     @relation(fields: [manufacturerId], references: [id])
  MedicationAvailability          MedicationAvailability[]
  Medication_MedicationIngredient Medication_MedicationIngredient[]
  PrescriptionMedication          PrescriptionMedication[]

  @@index([form])
  @@index([nafdacCode])
  @@index([route])
  @@index([brandName(ops: raw("gin_trgm_ops"))], map: "idx_medication_brandname_trgm", type: Gin)
}

model MedicationAvailability {
  medicationId Int
  pharmacyId   Int
  stock        Int?
  price        Float?
  receivedDate DateTime?
  expiryDate   DateTime?
  batchNumber  String?
  Medication   Medication     @relation(fields: [medicationId], references: [id])
  Pharmacy     Pharmacy       @relation(fields: [pharmacyId], references: [id])
  OrderItem    OrderItem[]
  PriceHistory PriceHistory[]

  @@id([medicationId, pharmacyId])
}

model MedicationIngredient {
  id                              Int                               @id @default(autoincrement())
  substanceId                     Int
  strengthValue                   Float?
  strengthUnit                    StrengthUnit?
  perUnitValue                    Float?
  perUnitType                     PackSizeUnit?
  ActiveSubstance                 ActiveSubstance                   @relation(fields: [substanceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Medication_MedicationIngredient Medication_MedicationIngredient[]

  @@unique([substanceId, strengthValue, strengthUnit, perUnitType], map: "unique_ingredient_per_strength")
  @@index([substanceId])
}

model Medication_MedicationIngredient {
  medicationId         Int
  ingredientId         Int
  MedicationIngredient MedicationIngredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ingredient")
  Medication           Medication           @relation(fields: [medicationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_medication")

  @@id([medicationId, ingredientId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model OperatingHour {
  id         Int       @id @default(autoincrement())
  pharmacyId Int
  dayOfWeek  Int       @db.SmallInt
  openTime   DateTime  @db.Time(6)
  closeTime  DateTime  @db.Time(6)
  createdAt  DateTime? @default(now()) @db.Timestamptz(6)
  Pharmacy   Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([pharmacyId, dayOfWeek, openTime, closeTime], map: "uniq_OperatingHour")
}

model Order {
  id                Int             @id @default(autoincrement())
  userIdentifier    String
  pharmacyId        Int?
  prescriptionId    Int?
  status            OrderStatus     @default(CART)
  deliveryMethod    DeliveryMethod? @default(UNSPECIFIED)
  address           String?
  email             String?
  phone             String?
  totalPrice        Float           @default(0)
  trackingCode      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime
  filledAt          DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  paymentReference  String?         @unique
  paymentStatus     PaymentStatus   @default(PENDING)
  paymentMethod     PaymentMethod?  @default(PAY_NOW)
  paymentChannel    String?
  checkoutSessionId String?
  name              String?
  Pharmacy          Pharmacy?       @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)
  Prescription      Prescription?   @relation(fields: [prescriptionId], references: [id])
  OrderItem         OrderItem[]

  @@index([paymentReference])
  @@index([userIdentifier])
}

model OrderItem {
  id                     Int                    @id @default(autoincrement())
  orderId                Int
  pharmacyId             Int
  medicationId           Int
  quantity               Int
  price                  Float
  Order                  Order                  @relation(fields: [orderId], references: [id])
  MedicationAvailability MedicationAvailability @relation(fields: [pharmacyId, medicationId], references: [pharmacyId, medicationId])

  @@unique([orderId, pharmacyId, medicationId])
}

model PharmacologicalClass {
  id               Int              @id @default(autoincrement())
  atcCode          String           @unique @db.VarChar(4)
  name             String
  parentId         Int
  ChemicalClass    ChemicalClass[]
  TherapeuticClass TherapeuticClass @relation(fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([name])
  @@index([parentId])
}

model Pharmacy {
  id                     Int                      @id @default(autoincrement())
  name                   String
  location               Unsupported("geometry")?
  address                String
  lga                    String
  state                  String
  phone                  String
  licenseNumber          String                   @unique
  pharmacyType           PharmacyType?            @default(COMMUNITY)
  status                 PharmacyStatus           @default(PENDING)
  createdAt              DateTime                 @default(now())
  verifiedAt             DateTime?
  logoUrl                String?
  isActive               Boolean                  @default(true)
  ward                   String?
  devicetoken            String?
  deliveryAvailability   Boolean?                 @default(false)
  latitude               Decimal?                 @db.Decimal(10, 8)
  longitude              Decimal?                 @db.Decimal(11, 8)
  locationAccuracy       Int?
  locationCapturedAt     DateTime?                @db.Timestamp(6)
  MedicationAvailability MedicationAvailability[]
  OperatingHour          OperatingHour[]
  Order                  Order[]
  PharmacyUser           PharmacyUser[]
  Sale                   Sale[]

  @@index([licenseNumber])
  @@index([name, state])
  @@index([location], map: "idx_pharmacy_location", type: Gist)
  @@index([latitude, longitude], map: "idx_pharmacy_lat_lon")
}

model PharmacyUser {
  id                  Int                   @id @default(autoincrement())
  email               String                @unique
  password            String
  name                String
  role                PharmacyUserRole      @default(MANAGER)
  pharmacyId          Int
  lastLogin           DateTime?
  createdAt           DateTime              @default(now())
  Pharmacy            Pharmacy              @relation(fields: [pharmacyId], references: [id])
  PharmacyUserConsent PharmacyUserConsent[]

  @@index([email])
}

model PharmacyUserConsent {
  id           Int          @id @default(autoincrement())
  userId       Int
  consentType  ConsentType
  granted      Boolean      @default(true)
  createdAt    DateTime     @default(now())
  PharmacyUser PharmacyUser @relation(fields: [userId], references: [id])

  @@unique([userId, consentType])
  @@index([userId])
}

model Prescription {
  id                     Int                      @id @default(autoincrement())
  userIdentifier         String
  fileUrl                String
  status                 PrescriptionStatus       @default(PENDING)
  createdAt              DateTime                 @default(now())
  email                  String?
  phone                  String?
  updatedAt              DateTime?                @default(now()) @db.Timestamptz(6)
  Order                  Order[]
  PrescriptionMedication PrescriptionMedication[]

  @@index([userIdentifier])
}

model PrescriptionMedication {
  id                 Int          @id @default(autoincrement())
  prescriptionId     Int
  medicationId       Int
  quantity           Int
  dosageInstructions String?
  Medication         Medication   @relation(fields: [medicationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Prescription       Prescription @relation(fields: [prescriptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model PriceHistory {
  id                     Int                    @id @default(autoincrement())
  medicationId           Int
  pharmacyId             Int
  price                  Float
  recordedAt             DateTime               @default(now())
  MedicationAvailability MedicationAvailability @relation(fields: [medicationId, pharmacyId], references: [medicationId, pharmacyId])
}

model Sale {
  id            Int      @id @default(autoincrement())
  pharmacyId    Int
  items         Json     @db.Json
  total         Float
  paymentMethod String
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  Pharmacy      Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pharmacy")
}

model TherapeuticClass {
  id                   Int                    @id @default(autoincrement())
  atcCode              String                 @unique @db.VarChar(3)
  name                 String
  parentId             Int
  PharmacologicalClass PharmacologicalClass[]
  AnatomicalClass      AnatomicalClass        @relation(fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([name])
  @@index([parentId])
}

model TransactionReference {
  id                   Int      @id @default(autoincrement())
  transactionReference String   @unique
  orderReferences      String[]
  checkoutSessionId    String
  createdAt            DateTime @default(now())

  @@index([transactionReference])
}

model UserConsent {
  id              Int         @id @default(autoincrement())
  userIdentifier  String
  consentType     ConsentType
  consentLanguage String?
  granted         Boolean     @default(true)
  createdAt       DateTime    @default(now())

  @@unique([userIdentifier, consentType])
  @@index([userIdentifier])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

model ProcessedWebhook {
  id          Int      @id @default(autoincrement())
  eventId     String   @unique @db.VarChar
  eventType   String   @db.VarChar
  processedAt DateTime @default(now()) @db.Timestamp(6)
  payload     Json?

  @@index([eventId])
  @@index([processedAt])
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
  SUPPORT
}

enum ConsentType {
  TERMS
  PRIVACY
  MARKETING
  DATA_SHARING
  REGULATORY
}

enum DeliveryMethod {
  UNSPECIFIED
  PICKUP
  COURIER
}

enum DosageForm {
  TABLET
  CAPSULE
  CAPLET
  SYRUP
  INJECTION
  CREAM
  OINTMENT
  GEL
  SUSPENSION
  POWDER
  SUPPOSITORY
  EYE_DROP
  EAR_DROP
  DROPS
  NASAL_SPRAY
  INHALER
  PATCH
  LOZENGE
  EFFERVESCENT
  GRANULES
  SOLUTION
  ORODISPERSIBLE_FILM
  INFUSION
  LYOPHILIZED_POWDER
  NEBULIZER_SOLUTION
  EYE_OINTMENT
  EAR_SPRAY
  LOTION
  PASTE
  FOAM
  MOUTHWASH
  IMPLANT
  MICROSPHERES
}

enum NafdacStatus {
  VALID
  EXPIRED
  PENDING
  SUSPENDED
}

enum OrderStatus {
  CART
  PENDING
  PENDING_PRESCRIPTION
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  READY_FOR_PICKUP
  CANCELLED
  COMPLETED
}

enum PackSizeUnit {
  TABLET
  CAPSULE
  ML
  VIAL
  AMPOULE
  SACHET
  PATCH
  BOTTLE
  TUBE
  BLISTER
}

enum PaymentMethod {
  PAY_NOW
  PAY_LATER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PharmacyStatus {
  PENDING
  VERIFIED
  SUSPENDED
  REJECTED
  CLOSED
}

enum PharmacyType {
  COMMUNITY
  HOSPITAL
  SPECIALTY
  PMV
}

enum PharmacyUserRole {
  MANAGER
  PHARMACIST
  ADMIN
  STAFF
  OWNER
  TECHNICIAN
}

enum PrescriptionStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum RegulatoryClass {
  OTC
  PRESCRIPTION_ONLY
  SCHEDULE_I
  SCHEDULE_II
  SCHEDULE_III
  SCHEDULE_IV
  SCHEDULE_V
  RESTRICTED
}

enum RestrictedTo {
  GENERAL
  HOSPITAL_ONLY
  SPECIALTY_PHARMACY
  CONTROLLED_SUBSTANCE
}

enum Route {
  ORAL
  INTRAVENOUS
  INTRAMUSCULAR
  SUBCUTANEOUS
  TOPICAL
  INHALATION
  RECTAL
  VAGINAL
  OPHTHALMIC
  OTIC
  NASAL
  SUBLINGUAL
  BUCCAL
  TRANSDERMAL
}

enum StrengthUnit {
  MG
  ML
  G
  MCG
  IU
  NG
  MMOL
  PERCENT
}

enum SubstanceType {
  BASE
  SALT
  ESTER
  HYDRATE
  COMPLEX
  ANHYDROUS
  AMORPHOUS
  PRODRUG
  ENANTIOMER
  POLYMORPH
}

enum Pharmacopeia {
  USP
  BP
  IP
  OTHER
}
