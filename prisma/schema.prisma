generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model ActiveSubstance {
  id                   Int                    @id @default(autoincrement())
  name                 String                 @unique(map: "active_substance_name_unique")
  type                 SubstanceType
  genericId            Int
  GenericName          GenericName            @relation(fields: [genericId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  MedicationIngredient MedicationIngredient[]

  @@index([genericId])
  @@index([name])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "idx_activesubstance_name_trgm", type: Gin)
}

model AdminUser {
  id                 Int                 @id @default(autoincrement())
  email              String              @unique
  password           String
  name               String
  role               AdminRole           @default(ADMIN)
  createdAt          DateTime            @default(now())
  AdminRefreshTokens AdminRefreshToken[]
  AdminRoleGrants    AdminRoleGrant[]    @relation("AdminRoleGrants")
  lastLoginAt        DateTime?
  disabledAt         DateTime?
  failedAttempts     Int                 @default(0)
  lockedUntil        DateTime?
  tokenVersion       Int                 @default(0)
  emailVerifiedAt    DateTime?
  mfaSecretEnc       String?
  mfaEnrolledAt      DateTime?

  @@index([email])
}

model AnatomicalClass {
  id               Int                @id @default(autoincrement())
  atcCode          String             @unique @db.VarChar(1)
  name             String
  TherapeuticClass TherapeuticClass[]
}

model ChemicalClass {
  id                   Int                  @id @default(autoincrement())
  atcCode              String               @unique @db.VarChar(5)
  name                 String
  parentId             Int
  PharmacologicalClass PharmacologicalClass @relation(fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ChemicalSubstance    ChemicalSubstance[]

  @@index([name])
  @@index([parentId])
}

model ChemicalSubstance {
  id                           Int                            @id @default(autoincrement())
  name                         String                         @db.VarChar
  atcCode                      String                         @unique @db.VarChar(7)
  parentId                     Int
  ChemicalClass                ChemicalClass                  @relation(fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  GenericNameChemicalSubstance GenericNameChemicalSubstance[]

  @@index([atcCode])
  @@index([name])
  @@index([parentId])
}

model Contraindication {
  id          Int         @id @default(autoincrement())
  description String
  genericId   Int
  GenericName GenericName @relation(fields: [genericId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([genericId])
}

model GenericName {
  id                           Int                            @id @default(autoincrement())
  name                         String                         @unique(map: "generic_name_unique")
  description                  String?
  ActiveSubstance              ActiveSubstance[]
  Contraindication             Contraindication[]
  GenericNameChemicalSubstance GenericNameChemicalSubstance[]
  Indication                   Indication[]

  @@index([name])
}

model GenericNameChemicalSubstance {
  id                  Int               @id @default(autoincrement())
  genericNameId       Int
  chemicalSubstanceId Int
  ChemicalSubstance   ChemicalSubstance @relation(fields: [chemicalSubstanceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  GenericName         GenericName       @relation(fields: [genericNameId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([genericNameId, chemicalSubstanceId])
  @@index([chemicalSubstanceId])
  @@index([genericNameId])
}

model Indication {
  id          Int         @id @default(autoincrement())
  description String
  genericId   Int
  GenericName GenericName @relation(fields: [genericId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([genericId])
}

model Manufacturer {
  id            Int          @id @default(autoincrement())
  name          String       @unique
  country       String?
  contactInfo   String?
  countryCode   String?      @db.VarChar(10)
  parentCompany String?      @db.VarChar(255)
  productCount  Int?
  originalNames String[]
  Medication    Medication[]

  @@index([name])
  @@index([countryCode], map: "idx_manufacturer_countryCode")
  @@index([name], map: "idx_manufacturer_name")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Medication {
  id                              Int                               @id @default(autoincrement())
  brandName                       String
  brandDescription                String?
  localNames                      String[]                          @default([])
  manufacturerId                  Int?
  form                            DosageForm?
  route                           Route?
  packSizeQuantity                Int?
  packSizeUnit                    PackSizeUnit?
  nafdacCode                      String?
  nafdacStatus                    NafdacStatus?                     @default(PENDING)
  prescriptionRequired            Boolean
  regulatoryClass                 RegulatoryClass?
  restrictedTo                    RestrictedTo?
  insuranceCoverage               Boolean?                          @default(false)
  createdAt                       DateTime                          @default(now())
  approvalDate                    DateTime?
  expiryDate                      DateTime?
  storageConditions               String?
  imageUrl                        String?
  fullName                        String?
  packSizeExpression              String?                           @db.VarChar(200)
  pharmacopeia                    Pharmacopeia?
  Manufacturer                    Manufacturer?                     @relation(fields: [manufacturerId], references: [id])
  MedicationAvailability          MedicationAvailability[]
  MedicationRoute                 MedicationRoute[]
  Medication_MedicationIngredient Medication_MedicationIngredient[]
  PrescriptionMedication          PrescriptionMedication[]

  @@index([form])
  @@index([nafdacCode])
  @@index([route])
  @@index([brandName(ops: raw("gin_trgm_ops"))], map: "idx_medication_brandname_trgm", type: Gin)
}

model MedicationAvailability {
  medicationId Int
  pharmacyId   Int
  stock        Int?
  price        Float?
  receivedDate DateTime?
  expiryDate   DateTime?
  batchNumber  String?
  Medication   Medication     @relation(fields: [medicationId], references: [id])
  Pharmacy     Pharmacy       @relation(fields: [pharmacyId], references: [id])
  OrderItem    OrderItem[]
  PriceHistory PriceHistory[]

  @@id([medicationId, pharmacyId])
  @@index([medicationId])
  @@index([pharmacyId])
  @@index([stock])
}

model MedicationIngredient {
  id                              Int                               @id @default(autoincrement())
  substanceId                     Int
  strengthValue                   Float?
  strengthUnit                    StrengthUnit?
  perUnitValue                    Float?
  perUnitType                     PackSizeUnit?
  ActiveSubstance                 ActiveSubstance                   @relation(fields: [substanceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Medication_MedicationIngredient Medication_MedicationIngredient[]

  @@unique([substanceId, strengthValue, strengthUnit, perUnitValue, perUnitType], map: "unique_ingredient_per_strength")
  @@index([substanceId])
}

model Medication_MedicationIngredient {
  medicationId         Int
  ingredientId         Int
  MedicationIngredient MedicationIngredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ingredient")
  Medication           Medication           @relation(fields: [medicationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_medication")

  @@id([medicationId, ingredientId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model OperatingHour {
  id         Int       @id @default(autoincrement())
  pharmacyId Int
  dayOfWeek  Int       @db.SmallInt
  openTime   DateTime  @db.Time(6)
  closeTime  DateTime  @db.Time(6)
  createdAt  DateTime? @default(now()) @db.Timestamptz(6)
  Pharmacy   Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([pharmacyId, dayOfWeek, openTime, closeTime], map: "uniq_OperatingHour")
}

model Order {
  id                Int             @id @default(autoincrement())
  userIdentifier    String
  pharmacyId        Int?
  prescriptionId    Int?
  status            OrderStatus     @default(CART)
  deliveryMethod    DeliveryMethod? @default(UNSPECIFIED)
  address           String?
  email             String?
  phone             String?
  totalPrice        Float           @default(0)
  trackingCode      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime
  filledAt          DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  paymentReference  String?         @unique
  paymentStatus     PaymentStatus   @default(PENDING)
  paymentMethod     PaymentMethod?  @default(PAY_NOW)
  paymentChannel    String?
  checkoutSessionId String?
  name              String?
  platformFee       Float?
  pharmacyAmount    Float?
  payoutStatus      PayoutStatus?
  payoutReference   String?         @unique(map: "Order_payoutReference_unique") @db.VarChar(255)
  payoutInitiatedAt DateTime?
  payoutCompletedAt DateTime?
  Pharmacy          Pharmacy?       @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)
  Prescription      Prescription?   @relation(fields: [prescriptionId], references: [id])
  OrderItem         OrderItem[]
  Refund            Refund[]

  @@index([paymentReference])
  @@index([userIdentifier])
  @@index([checkoutSessionId])
  @@index([createdAt])
  @@index([pharmacyId, status])
  @@index([status])
  @@index([userIdentifier, status])
  @@index([payoutStatus])
}

model OrderItem {
  id                     Int                    @id @default(autoincrement())
  orderId                Int
  pharmacyId             Int
  medicationId           Int
  quantity               Int
  price                  Float
  Order                  Order                  @relation(fields: [orderId], references: [id])
  MedicationAvailability MedicationAvailability @relation(fields: [pharmacyId, medicationId], references: [pharmacyId, medicationId])

  @@unique([orderId, pharmacyId, medicationId])
}

model PharmacologicalClass {
  id               Int              @id @default(autoincrement())
  atcCode          String           @unique @db.VarChar(4)
  name             String
  parentId         Int
  ChemicalClass    ChemicalClass[]
  TherapeuticClass TherapeuticClass @relation(fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([name])
  @@index([parentId])
}

model Pharmacy {
  id                     Int                      @id @default(autoincrement())
  name                   String
  location               Unsupported("geometry")?
  address                String
  lga                    String
  state                  String
  phone                  String
  licenseNumber          String                   @unique
  pharmacyType           PharmacyType?            @default(COMMUNITY)
  status                 PharmacyStatus           @default(PENDING)
  createdAt              DateTime                 @default(now())
  verifiedAt             DateTime?
  logoUrl                String?
  isActive               Boolean                  @default(true)
  ward                   String?
  devicetoken            String?
  deliveryAvailability   Boolean?                 @default(false)
  latitude               Decimal?                 @db.Decimal(10, 8)
  longitude              Decimal?                 @db.Decimal(11, 8)
  locationAccuracy       Int?
  locationCapturedAt     DateTime?                @db.Timestamp(6)
  bankAccountNumber      String?                  @db.VarChar(10)
  bankCode               String?                  @db.VarChar(10)
  bankName               String?                  @db.VarChar(100)
  accountName            String?                  @db.VarChar(255)
  recipientCode          String?                  @unique(map: "Pharmacy_recipientCode_unique") @db.VarChar(255)
  MedicationAvailability MedicationAvailability[]
  OperatingHour          OperatingHour[]
  Order                  Order[]
  Payout                 Payout[]
  PharmacySetting        PharmacySetting?
  PharmacyUser           PharmacyUser[]
  PushToken              PushToken[]
  Sale                   Sale[]

  @@index([licenseNumber])
  @@index([name, state])
  @@index([latitude, longitude], map: "idx_pharmacy_lat_lon")
  @@index([location], map: "idx_pharmacy_location", type: Gist)
}

model PharmacyUser {
  id                   Int                    @id @default(autoincrement())
  email                String                 @unique
  password             String
  name                 String
  role                 PharmacyUserRole       @default(MANAGER)
  pharmacyId           Int
  lastLogin            DateTime?
  createdAt            DateTime               @default(now())
  Pharmacy             Pharmacy               @relation(fields: [pharmacyId], references: [id])
  PharmacyUserConsent  PharmacyUserConsent[]
  PushToken            PushToken[]
  PharmacyRefreshToken PharmacyRefreshToken[]
  status               String                 @default("ACTIVE") @db.VarChar(12)
  tokenVersion         Int                    @default(0)
  failedAttempts       Int                    @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  lastLoginIp          String?                @db.VarChar(45)
  pinChangedAt         DateTime?
  mustChangePin        Boolean                @default(false)
  pinHashVersion       Int                    @default(1) @db.SmallInt
  phone                String?                @db.VarChar(20)
  invitedAt            DateTime?
  disabledAt           DateTime?
  lastActiveAt         DateTime?                @db.Timestamp(3)
  invitedById          Int?
  suspendedAt          DateTime?                @db.Timestamp(3)
  suspendedById        Int?
  removedAt            DateTime?                @db.Timestamp(3)
  removedLabel         String?                  @db.VarChar(200)
  licenceNumber        String?                  @db.VarChar(50)
  licenceVerifiedAt    DateTime?                @db.Timestamp(3)
  PharmacyUserInvite   PharmacyUserInvite[]

  @@index([email])
  @@index([pharmacyId, status])
}

model PharmacyRefreshToken {
  id           Int          @id @default(autoincrement())
  userId       Int
  familyId     String       @db.VarChar(36)
  tokenHash    String       @unique @db.VarChar(64)
  expiresAt    DateTime
  revokedAt    DateTime?
  rotatedAt    DateTime?
  deviceInfo   String?      @db.VarChar(200)
  deviceId     String?      @db.VarChar(64)
  lastUsedAt   DateTime?
  lastIp       String?      @db.VarChar(45)
  createdAt    DateTime     @default(now())
  PharmacyUser PharmacyUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model PushToken {
  id           Int          @id @default(autoincrement())
  userId       Int
  pharmacyId   Int
  token        String       @unique
  platform     String       @db.VarChar(20)
  createdAt    DateTime     @default(now())
  lastSeenAt   DateTime     @default(now())
  PharmacyUser PharmacyUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  Pharmacy     Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([pharmacyId])
  @@index([userId])
}

model PharmacyUserConsent {
  id           Int          @id @default(autoincrement())
  userId       Int
  consentType  ConsentType
  granted      Boolean      @default(true)
  createdAt    DateTime     @default(now())
  PharmacyUser PharmacyUser @relation(fields: [userId], references: [id])

  @@unique([userId, consentType])
  @@index([userId])
}

model Prescription {
  id                     Int                      @id @default(autoincrement())
  userIdentifier         String
  fileUrl                String
  status                 PrescriptionStatus       @default(PENDING)
  createdAt              DateTime                 @default(now())
  email                  String?
  phone                  String?
  updatedAt              DateTime?                @default(now()) @db.Timestamptz(6)
  expiryDate             DateTime                 @db.Timestamp(6)
  expiryDays             Int                      @default(30)
  rejectionReason        String?
  Order                  Order[]
  PrescriptionMedication PrescriptionMedication[]

  @@index([userIdentifier])
}

model PrescriptionMedication {
  id                 Int              @id @default(autoincrement())
  prescriptionId     Int
  medicationId       Int
  quantity           Int
  dosageInstructions String?
  dosageAmount       String?
  dosageFrequency    DosageFrequency?
  dosageTiming       DosageTiming?
  durationValue      Int?
  durationType       DurationType?    @default(DAYS)
  Medication         Medication       @relation(fields: [medicationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Prescription       Prescription     @relation(fields: [prescriptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model PriceHistory {
  id                     Int                    @id @default(autoincrement())
  medicationId           Int
  pharmacyId             Int
  price                  Float
  recordedAt             DateTime               @default(now())
  MedicationAvailability MedicationAvailability @relation(fields: [medicationId, pharmacyId], references: [medicationId, pharmacyId])
}

model Sale {
  id            Int      @id @default(autoincrement())
  pharmacyId    Int
  items         Json     @db.Json
  total         Float
  paymentMethod String
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  Pharmacy      Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pharmacy")
}

model TherapeuticClass {
  id                   Int                    @id @default(autoincrement())
  atcCode              String                 @unique @db.VarChar(3)
  name                 String
  parentId             Int
  PharmacologicalClass PharmacologicalClass[]
  AnatomicalClass      AnatomicalClass        @relation(fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([name])
  @@index([parentId])
}

model TransactionReference {
  id                   Int      @id @default(autoincrement())
  transactionReference String   @unique
  orderReferences      String[]
  checkoutSessionId    String
  createdAt            DateTime @default(now())

  @@index([transactionReference])
}

model UserConsent {
  id              Int         @id @default(autoincrement())
  userIdentifier  String
  consentType     ConsentType
  consentLanguage String?
  granted         Boolean     @default(true)
  createdAt       DateTime    @default(now())

  @@unique([userIdentifier, consentType])
  @@index([userIdentifier])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

model ProcessedWebhook {
  id          Int      @id @default(autoincrement())
  eventId     String   @unique @db.VarChar
  eventType   String   @db.VarChar
  processedAt DateTime @default(now()) @db.Timestamp(6)
  payload     Json?

  @@index([eventId])
  @@index([processedAt])
}

model Refund {
  id                Int          @id @default(autoincrement())
  orderId           Int
  amount            Decimal      @db.Decimal(10, 2)
  reason            String       @db.VarChar
  refundType        RefundType
  status            RefundStatus
  paystackRefundId  String?      @db.VarChar
  processedAt       DateTime?    @db.Timestamp(6)
  createdAt         DateTime     @default(now()) @db.Timestamp(6)
  initiatedBy       Int?
  failureReason     String?      @db.VarChar
  retryCount        Int          @default(0)
  lastRetryAt       DateTime?    @db.Timestamp(6)
  paystackResponse  Json?
  paystackReference String?      @db.VarChar
  Order             Order        @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(50)
  entityId   Int
  userId     Int?
  details    Json?
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(500)
  createdAt  DateTime @default(now()) @db.Timestamp(6)

  @@index([action])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId])
}

model ReconciliationReport {
  id                  Int      @id @default(autoincrement())
  reconciliationDate  DateTime @db.Date
  startDate           DateTime @db.Date
  endDate             DateTime @db.Date
  status              String   @db.VarChar(50)
  totalPaystackTxns   Int      @default(0)
  totalDatabaseOrders Int      @default(0)
  matchedCount        Int      @default(0)
  mismatchCount       Int      @default(0)
  paystackTotalAmount Decimal  @db.Decimal(10, 2)
  databaseTotalAmount Decimal  @db.Decimal(10, 2)
  discrepancyAmount   Decimal  @db.Decimal(10, 2)
  discrepancies       Json?
  executionTimeMs     Int?
  triggeredBy         String?  @db.VarChar(100)
  errorMessage        String?
  createdAt           DateTime @default(now()) @db.Timestamp(6)
  updatedAt           DateTime @default(now()) @db.Timestamp(6)

  @@index([createdAt])
  @@index([reconciliationDate])
  @@index([status])
}

model Payout {
  id               Int          @id @default(autoincrement())
  pharmacyId       Int
  amount           Float
  orderIds         Int[]        @default([])
  status           PayoutStatus
  reference        String       @unique @db.VarChar(255)
  initiatedAt      DateTime     @default(now())
  completedAt      DateTime?
  failureReason    String?
  paystackResponse Json?
  Pharmacy         Pharmacy     @relation(fields: [pharmacyId], references: [id])

  @@index([initiatedAt])
  @@index([pharmacyId])
  @@index([reference])
  @@index([status])
}

model MedicationRoute {
  id            Int        @id @default(autoincrement())
  medication_id Int
  route         String     @db.VarChar(50)
  created_at    DateTime?  @default(now()) @db.Timestamp(6)
  Medication    Medication @relation(fields: [medication_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([medication_id, route], map: "uq_medication_route")
  @@index([medication_id], map: "idx_medicationroute_medication_id")
}

/// Audit and security events (append-only). Mirrors prisma/sql/sec-02-audit-shared.sql.
/// Change BOTH files together; Prisma must not drift from the database.
/// Note: id is BIGSERIAL, so Prisma returns BigInt. res.json() cannot serialise BigInt -
/// convert to string before sending (Doc 1 section 5.2).
model AuditEvent {
  id         BigInt    @id @default(autoincrement())
  occurredAt DateTime  @default(now()) @map("occurredAt") @db.Timestamp(3)
  clientAt   DateTime? @map("clientAt") @db.Timestamp(3)
  kind       String    @default("audit") @db.VarChar(10)
  action     String    @db.VarChar(80)
  outcome    String    @default("success") @db.VarChar(10)
  severity   String    @default("info") @db.VarChar(10)
  actorType  String    @map("actorType") @db.VarChar(16)
  actorId    String?   @map("actorId") @db.VarChar(64)
  actorRole  String?   @map("actorRole") @db.VarChar(24)
  actorLabel String?   @map("actorLabel") @db.VarChar(120)
  pharmacyId Int?      @map("pharmacyId")
  entityType String?   @map("entityType") @db.VarChar(40)
  entityId   String?   @map("entityId") @db.VarChar(64)
  before     Json?
  after      Json?
  sessionId  String?   @map("sessionId") @db.VarChar(36)
  deviceId   String?   @map("deviceId") @db.VarChar(64)
  ip         String?   @db.VarChar(45)
  userAgent  String?   @map("userAgent") @db.VarChar(300)
  requestId  String?   @map("requestId") @db.VarChar(40)
  visibility String    @default("both") @db.VarChar(10)

  @@index([pharmacyId, occurredAt(sort: Desc)], map: "AuditEvent_pharm_idx")
  @@index([actorType, actorId, occurredAt(sort: Desc)], map: "AuditEvent_actor_idx")
  @@index([entityType, entityId], map: "AuditEvent_entity_idx")
  @@index([kind, severity, occurredAt(sort: Desc)], map: "AuditEvent_sec_idx")
  @@map("AuditEvent")
}

/// Rate-limit counters that survive a restart (FND-07). Mirrors sec-02-audit-shared.sql.
model AuthThrottle {
  key         String    @id @db.VarChar(160)
  count       Int       @default(0)
  windowStart DateTime  @default(now()) @map("windowStart") @db.Timestamp(3)
  lockedUntil DateTime? @map("lockedUntil") @db.Timestamp(3)
  level       Int       @default(0) @db.SmallInt
  updatedAt   DateTime  @default(now()) @map("updatedAt") @db.Timestamp(3)

  @@index([updatedAt], map: "AuthThrottle_updated_idx")
  @@map("AuthThrottle")
}

/// Replay-safe writes (FND-10, Doc 1 section 5.1 step 10). Mirrors sec-02-audit-shared.sql.
model IdempotencyKey {
  key            String   @db.VarChar(64)
  actorType      String   @map("actorType") @db.VarChar(16)
  actorId        String   @map("actorId") @db.VarChar(64)
  route          String   @db.VarChar(120)
  requestHash    String   @map("requestHash") @db.VarChar(64)
  state          String   @default("IN_PROGRESS") @db.VarChar(12)
  responseStatus Int?     @map("responseStatus") @db.SmallInt
  responseBody   Json?    @map("responseBody")
  createdAt      DateTime @default(now()) @map("createdAt") @db.Timestamp(3)
  expiresAt      DateTime @default(dbgenerated("(CURRENT_TIMESTAMP + '24:00:00'::interval)")) @map("expiresAt") @db.Timestamp(3)

  @@id([actorType, actorId, key])
  @@index([expiresAt], map: "IdempotencyKey_expires_idx")
  @@map("IdempotencyKey")
}

/// Maker-checker approvals (Doc 2/3 build on this). Mirrors sec-02-audit-shared.sql.
model ApprovalRequest {
  id          BigInt    @id @default(autoincrement())
  scope       String    @default("platform") @db.VarChar(10)
  pharmacyId  Int?      @map("pharmacyId")
  action      String    @db.VarChar(80)
  payload     Json
  payloadHash String    @map("payloadHash") @db.VarChar(64)
  makerType   String    @map("makerType") @db.VarChar(16)
  makerId     String    @map("makerId") @db.VarChar(64)
  status      String    @default("PENDING") @db.VarChar(10)
  checkerType String?   @map("checkerType") @db.VarChar(16)
  checkerId   String?   @map("checkerId") @db.VarChar(64)
  decidedAt   DateTime? @map("decidedAt") @db.Timestamp(3)
  expiresAt   DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP + '24:00:00'::interval)")) @map("expiresAt") @db.Timestamp(3)
  createdAt   DateTime  @default(now()) @map("createdAt") @db.Timestamp(3)

  @@index([status, expiresAt], map: "ApprovalRequest_status_idx")
  @@map("ApprovalRequest")
}

/// Device registry (FND-09, Doc 2). Mirrors sec-01-identity-session.sql.
model UserDevice {
  id          BigInt    @id @default(autoincrement())
  actorType   String    @db.VarChar(16)
  actorId     Int
  deviceId    String    @db.VarChar(64)
  label       String?   @db.VarChar(120)
  publicKey   String?
  platform    String?   @db.VarChar(20)
  approvedById Int?
  approvedAt  DateTime? @db.Timestamp(3)
  trusted     Boolean   @default(false)
  firstSeenAt DateTime  @default(now()) @db.Timestamp(3)
  lastSeenAt  DateTime  @default(now()) @db.Timestamp(3)
  lastIp      String?   @db.VarChar(45)
  revokedAt   DateTime? @db.Timestamp(3)

  @@unique([actorType, actorId, deviceId], map: "UserDevice_actor_device_key")
  @@map("UserDevice")
}

model PharmacyUserInvite {
  id          Int       @id @default(autoincrement())
  userId      Int
  codeHash    String    @unique @db.VarChar(64)
  expiresAt   DateTime  @db.Timestamp(3)
  usedAt      DateTime? @db.Timestamp(3)
  attempts    Int       @default(0) @db.SmallInt
  createdById Int?
  createdAt   DateTime  @default(now()) @db.Timestamp(3)
  PharmacyUser PharmacyUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("PharmacyUserInvite")
}

model PharmacySetting {
  pharmacyId             Int      @id
  requireDeviceApproval  Boolean  @default(true)
  staffOpeningHoursOnly  Boolean  @default(false)
  lockAfterSeconds       Int      @default(60)
  discountCapPct         Decimal  @default(0) @db.Decimal(5, 2)
  voidWindowMinutes      Int      @default(10)
  adjustThresholdUnits   Int      @default(20)
  adjustApprovalUnits    Int      @default(100)
  priceChangeCapPct      Int      @default(30)
  refundLimitKobo        BigInt   @default(5000000)
  bankHoldHours          Int      @default(48)
  dailyDigest            Boolean  @default(true)
  updatedAt              DateTime @default(now()) @db.Timestamp(3)
  updatedById            Int?
  Pharmacy               Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@map("PharmacySetting")
}

/// Admin rotating refresh tokens (Doc 3). Mirrors sec-01-identity-session.sql.
model AdminRefreshToken {
  id         Int       @id @default(autoincrement())
  adminId    Int
  familyId   String    @db.VarChar(36)
  tokenHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime  @db.Timestamp(3)
  revokedAt  DateTime? @db.Timestamp(3)
  rotatedAt  DateTime? @db.Timestamp(3)
  deviceId   String?   @db.VarChar(64)
  deviceInfo String?   @db.VarChar(200)
  lastIp     String?   @db.VarChar(45)
  createdAt  DateTime  @default(now()) @db.Timestamp(3)
  AdminUser  AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId], map: "AdminRefreshToken_admin_idx")
  @@index([familyId], map: "AdminRefreshToken_family_idx")
  @@map("AdminRefreshToken")
}

/// Admin role grants (Doc 3). Mirrors sec-01-identity-session.sql.
model AdminRoleGrant {
  id        Int       @id @default(autoincrement())
  adminId   Int
  role      String    @db.VarChar(24)
  grantedBy Int?
  grantedAt DateTime  @default(now()) @db.Timestamp(3)
  revokedAt DateTime? @db.Timestamp(3)
  AdminUser AdminUser @relation("AdminRoleGrants", fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, role], map: "AdminRoleGrant_active_key")
  @@map("AdminRoleGrant")
}

