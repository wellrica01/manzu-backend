{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "migrate": "prisma migrate dev",
    "seed": "node src/seed.js",
    "backup": "node scripts/backup.js",
    "backup:daily": "node scripts/backup.js daily",
    "backup:weekly": "node scripts/backup.js weekly",
    "backup:monthly": "node scripts/backup.js monthly",
    "backup:list": "node scripts/backup.js list",
    "backup:stats": "node scripts/backup.js stats",
    "backup:cleanup": "node scripts/backup.js cleanup",
    "restore:list": "node scripts/restore.js list",
    "restore": "node scripts/restore.js restore",
    "test": "jest --runInBand --detectOpenHandles",
    "test:watch": "jest --watch --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:integration": "jest --testPathPattern=integration --runInBand"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@paystack/inline-js": "^2.22.4",
    "@prisma/client": "^6.11.1",
    "@sendgrid/mail": "^8.1.5",
    "@sentry/node": "^10.22.0",
    "@sentry/profiling-node": "^10.22.0",
    "@supabase/supabase-js": "^2.53.1",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "file-type": "^21.0.0",
    "helmet": "^8.1.0",
    "isomorphic-dompurify": "^2.30.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^4.0.5",
    "node-geocoder": "^4.4.1",
    "paystack-api": "^2.0.6",
    "sharp": "^0.34.4",
    "twilio": "^5.6.1",
    "uuid": "^11.1.0",
    "validator": "^13.15.15",
    "xss": "^1.0.15",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "eslint": "^9.36.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prisma": "^6.11.1",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/?(*.)+(spec|test).js"
    ],
    "testTimeout": 30000,
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  }
}
